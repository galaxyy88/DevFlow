# Valores fictícios apenas para mostrar o formato. Configure os valores reais em .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://example_user:example_password@localhost:5432/example_database
TEST_DATABASE_URL=postgresql://example_user:example_password@localhost:5432/devflow_security_test
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=example-only-change-this-local-password
JWT_SECRET=example-only-replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h
DB_SSL=false
