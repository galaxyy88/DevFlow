{
  "name": "devflow",
  "version": "1.0.0",
  "private": true,
  "description": "Gerenciador de projetos e tarefas para pequenos times de desenvolvimento.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node server/database/migrate.js",
    "test": "node --test server/utils/validation.test.js",
    "test:integration": "node --test server/integration.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
